# Required in all environments
DATABASE_URL=postgresql://creotec_user:creotec_pass_ChangeMe@localhost:5433/mechalabx_db
JWT_SECRET=replace_with_long_random_secret

# Runtime / deployment
PORT=4000
NODE_ENV=development
# Set to require for Supabase/Railway if you want to force SSL explicitly.
DATABASE_SSL=
# Comma-separated allowlist for browser origins. Set this to your Vercel frontend URL in production.
CORS_ORIGIN=http://localhost:5173
# Optional alias if you prefer naming the deployed frontend URL separately.
CLIENT_URL=
# Leave blank to use the safe default: true outside production, false in production.
RUN_BOOTSTRAP_MIGRATIONS=

# Auth / session
JWT_EXPIRES_IN=8h
ENABLE_DEV_GOD_MODE=false
ADMIN_EMAILS=

# Trainee password handling
DEFAULT_TRAINEE_PASSWORD=P@ssw0rd!
# Dev-only: never enable in production, or plaintext generated passwords may be returned once in create response.
RETURN_GENERATED_PASSWORD=true

# Optional Supabase Storage integration for lesson PDF uploads.
# Leave blank if Railway should use local disk in development only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional credential-email delivery via Brevo API.
BREVO_API_KEY=
SMTP_FROM="CREO MechaLab X <no-reply@example.com>"
